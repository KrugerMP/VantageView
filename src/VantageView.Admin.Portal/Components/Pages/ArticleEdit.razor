@page "/articles/new"
@page "/articles/{Id:guid}/edit"
@rendermode InteractiveServer

<PageTitle>@(IsNew ? "New Article" : "Edit Article")</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">Please <a href="/login">log in</a> to edit articles.</div>
    return;
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">@(IsNew ? "Create Article" : "Edit Article")</h4>
                <EditForm Model="model" OnValidSubmit="HandleSaveAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <InputText @bind-Value="model.Title" class="form-control" placeholder="Article title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Summary</label>
                        <InputTextArea @bind-Value="model.Summary" class="form-control" rows="2" placeholder="Brief summary" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Content</label>
                        <InputTextArea @bind-Value="model.Content" class="form-control" rows="10" placeholder="Full article content" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Publish Date</label>
                        <InputDate @bind-Value="_publishDate" class="form-control" />
                    </div>
                    @if (error is not null)
                    {
                        <div class="alert alert-danger">@error</div>
                    }
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@loading">@(loading ? "Saving..." : "Save")</button>
                        <a href="/articles" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
