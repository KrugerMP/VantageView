@page "/articles"
@rendermode InteractiveServer

<PageTitle>Manage Articles</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">Please <a href="/login">log in</a> to manage articles.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Articles</h1>
    <a href="/articles/new" class="btn btn-primary">New Article</a>
</div>

@if (Loading)
{
    <p><em>Loading...</em></p>
}
else if (Error is not null)
{
    <div class="alert alert-danger">@Error</div>
}
else if (ArticleList.Count == 0)
{
    <div class="alert alert-info">No articles yet. <a href="/articles/new">Create one</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Published</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (ArticleListItemDto article in ArticleList)
                {
                    <tr>
                        <td>@article.Title</td>
                        <td>@article.Author</td>
                        <td>@article.PublishedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a href="/articles/@article.Id/edit" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(article)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ArticleToDelete is not null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Article</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    Delete "@ArticleToDelete.Title"?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DoDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}
