@inherits LayoutComponentBase

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1.5rem" Style="width: 100%; padding: 0.75rem 1.5rem;">
            <RadzenLink Path="/" Text="  VantageView" Icon="newspaper" Style="font-weight: 600; font-size: 1.25rem; text-decoration: none;" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        <article style="padding: 1rem;">
            @Body
        </article>
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
