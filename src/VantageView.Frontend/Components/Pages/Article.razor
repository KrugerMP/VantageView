@page "/article/{Id:int}"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@using VantageView.Frontend.Models

<PageTitle>@(article?.Title ?? "Article")</PageTitle>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
    <a href="/" class="btn btn-outline-secondary">Back to list</a>
}
else if (article is null)
{
    <div class="alert alert-warning">Article not found.</div>
    <a href="/" class="btn btn-outline-secondary">Back to list</a>
}
else
{
    <article class="article-detail">
        <a href="/" class="text-decoration-none mb-3 d-inline-block">&larr; Back to news</a>
        <header class="mb-4">
            <h1>@article.Title</h1>
            <div class="text-muted small mb-3">
                <span>@article.Author</span> &middot; <span>@article.PublishedAt.ToString("MMMM d, yyyy")</span>
            </div>
        </header>
        <div class="article-content">
            @((MarkupString)MarkdownToHtml(article.Content))
        </div>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ArticleDto? article;
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("Api");
            HttpResponseMessage response = await client.GetAsync($"api/articles/{Id}");
            if (response.IsSuccessStatusCode)
            {
                article = await response.Content.ReadFromJsonAsync<ArticleDto>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                article = null;
            }
            else
            {
                error = "Failed to load article.";
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load article: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private static string MarkdownToHtml(string content)
    {
        // Simple plain text to paragraphs - can be replaced with a Markdown library
        string escaped = System.Net.WebUtility.HtmlEncode(content);
        string[] paragraphs = escaped.Split("\n\n", StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", paragraphs.Select(p => $"<p>{p.Replace("\n", "<br/>")}</p>"));
    }
}
