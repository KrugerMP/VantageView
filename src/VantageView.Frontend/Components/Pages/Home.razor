@page "/"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@using VantageView.Frontend.Models

<PageTitle>News Articles</PageTitle>

<h1>Corporate News</h1>

@if (loading)
{
    <p><em>Loading articles...</em></p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (articles.Count == 0)
{
    <p>No articles yet. Check back soon!</p>
}
else
{
    <div class="row g-4">
        @foreach (var article in articles)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a href="/article/@article.Id" class="text-decoration-none">@article.Title</a>
                        </h5>
                        <p class="card-text text-muted small">@article.Summary</p>
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">@article.Author</small>
                            <small class="text-muted">@article.PublishedAt.ToString("MMM d, yyyy")</small>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0">
                        <a href="/article/@article.Id" class="btn btn-sm btn-outline-primary">Read more</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ArticleListItemDto> articles = [];
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var result = await client.GetFromJsonAsync<List<ArticleListItemDto>>("api/articles");
            articles = result ?? [];
        }
        catch (Exception ex)
        {
            error = $"Failed to load articles: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }
}
