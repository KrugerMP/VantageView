@page "/"
@rendermode InteractiveServer

<PageTitle>News Articles</PageTitle>

<RadzenText TextStyle="TextStyle.H3" style="margin-bottom: 1.5rem;">Latest Corporate News</RadzenText>

@if (loading)
{
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
        <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Small" />
        <RadzenText>Loading articles...</RadzenText>
    </RadzenStack>
}
else if (error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Title="Error" Variant="Variant.Flat">
        @error
    </RadzenAlert>
}
else if (articles.Count == 0)
{
    <RadzenText>No articles yet. Check back soon!</RadzenText>
}
else
{
    <RadzenRow Gap="1.5rem">
        @foreach (ArticleListItemDto article in articles)
        {
            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                <RadzenCard style="height: 100%; display: flex; flex-direction: column;">
                    <RadzenStack Gap="0.5rem" style="flex: 1;">
                        <RadzenText TextStyle="TextStyle.H6" style="margin: 0;">
                            <RadzenLink Path="@($"/article/{article.Id}")" Text="@article.Title" />
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" style="color: var(--rz-base-600); margin: 0;">@article.Summary</RadzenText>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" style="margin-top: auto;">
                            <RadzenText TextStyle="TextStyle.Caption" style="color: var(--rz-base-500);">Published By: @article.Author</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" style="color: var(--rz-base-500);">Published On: @article.PublishedAt.ToString("MMM d, yyyy")</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                    <RadzenLink Path="@($"/article/{article.Id}")" Text="Read more" Icon="arrow_forward" style="margin-top: 1rem; display: inline-flex; align-items: center; gap: 0.5rem;" />
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
}
